{
  "name": "task-dashboard",
  "version": "0.1.0",
  "private": true,
"scripts": {
    "dev": "concurrently -n web,api -c blue,green \"next dev\" \"npm:api\"",
    "api": "json-server --watch db.json --port 4000 --delay 400",
